{
  "schema_version": "tbbcc.model_zoo.registry.v1",
  "description": "Canonical small-model suite for GPU-vs-NPU numerical characterization. Weights are downloaded into TBBCC_MODEL_CACHE and are not stored in this repository.",
  "cache_env": "TBBCC_MODEL_CACHE",
  "default_cache": "~/.cache/torchbridgebench/models",
  "models": [
    {
      "model_id": "resnet18_imagenet_224",
      "display_name": "ResNet-18",
      "task": "image_classification",
      "architecture_family": "cnn_residual",
      "input_shape": [1, 3, 224, 224],
      "precision_modes": ["fp32"],
      "pretrained_weights": {
        "source": "torchvision",
        "locator": "torchvision.models.ResNet18_Weights.IMAGENET1K_V1",
        "download_note": "Downloaded automatically by torchvision into the configured model cache."
      },
      "dataset_probe": {
        "name": "ImageNet-style calibration subset",
        "storage": "external",
        "readme_anchor": "imagenet-style-probe"
      },
      "metrics": ["top1", "top5", "latency_ms", "throughput_img_s", "peak_memory_mb", "fne_curve", "gc_curve", "first_divergence_layer"],
      "hooks": {
        "activation_layers": ["conv1", "layer1", "layer2", "layer3", "layer4", "avgpool", "fc"],
        "gradient_layers": ["conv1", "layer1.0.conv1", "layer2.0.conv1", "layer3.0.conv1", "layer4.0.conv1", "fc"]
      },
      "torch4ms_status": "planned_existing_team_adapter",
      "figure_role": "primary_case_study"
    },
